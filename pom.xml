<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<!-- spring-boot-starter-parent is a "BOM" (Bill of Materials): it pins a single
	     compatible version for every Spring/third-party dependency below, so none of
	     the <dependency> blocks need their own <version> tag - just declaring version
	     4.1.1 ONCE here keeps the whole dependency tree internally consistent. It also
	     configures sensible defaults for the compiler plugin, resource filtering, etc. -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.1</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.example</groupId>
	<artifactId>demo</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name/>
	<description/>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>25</java.version>
	</properties>
	<dependencies>
		<!-- "webmvc" not "web": this project's fictional-future Spring Boot version renamed
		     the classic spring-boot-starter-web to spring-boot-starter-webmvc. Pulls in
		     embedded Tomcat, Spring MVC (@RestController/@GetMapping/etc.), and Jackson for
		     JSON - the whole "serve an HTTP API" capability in one starter. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc</artifactId>
		</dependency>

		<!-- Dev-time only (scope=runtime, optional=true so it never leaks into a downstream
		     consumer's classpath): auto-restarts the app when compiled classes change, for
		     a faster local edit-run loop. Has zero effect on the packaged production jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>

		<!-- Provides JUnit 5, Mockito, AssertJ, and MockMvc/@WebMvcTest support - the
		     testing equivalent of spring-boot-starter-webmvc above. scope=test means this
		     (and everything it pulls in) is on the classpath ONLY when running tests,
		     never bundled into the runnable application jar. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-webmvc-test</artifactId>
			<scope>test</scope>
		</dependency>

		<!-- Spring Data JPA + Hibernate: turns MessageRepository (an interface with no
		     implementation written anywhere) into working database access at runtime -
		     see MessageRepository.java for how little code that actually requires. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>

		<!-- Exposes /actuator/health (readiness/liveness for Kubernetes probes) and
		     other production-readiness endpoints. Required before /actuator/prometheus
		     below can exist at all. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>

		<!-- Registers a Prometheus-format metrics endpoint (/actuator/prometheus) with
		     Micrometer, Spring Boot's metrics facade. Without this specific registry
		     dependency, Actuator's metrics exist internally but aren't exposed in a
		     format Prometheus knows how to scrape. -->
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
		</dependency>

		<!-- Bean Validation (Hibernate Validator under the hood) - what actually makes
		     @NotBlank on CreateMessageRequest.text and @Valid on the controller parameter
		     do anything. Without this dependency those annotations are present but inert. -->
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>

		<!-- The REAL production JDBC driver - Postgres. scope=runtime because application
		     code never references PostgreSQL-specific classes directly; only Spring Data
		     JPA/Hibernate needs the driver present at runtime to open a connection. -->
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>

		<!-- An in-memory database used ONLY for tests (scope=test) - see
		     src/test/resources/application.properties for where it actually gets wired in.
		     Lets @SpringBootTest boot a full, real JPA context without needing an actual
		     reachable Postgres instance in the build environment. -->
		<dependency>
			<groupId>com.h2database</groupId>
			<artifactId>h2</artifactId>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<!-- Without this plugin, `mvn package` would produce a "thin" jar containing
			     only this project's own classes - useless on its own, since none of its
			     dependencies (Spring, Tomcat, Hibernate...) would be bundled. This plugin's
			     "repackage" goal (bound automatically to the package phase, no extra
			     config needed) rewrites that jar into an executable "fat jar" with every
			     dependency nested inside under BOOT-INF/, plus the loader classes that let
			     `java -jar app.jar` run it directly with no separate application server -
			     see flux-infra's Dockerfile note in the learning docs for what happens
			     when this step's output is packaged incorrectly. -->
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
		</plugins>
	</build>

</project>
